# ==============================================================================
# Crystal Games - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the root directory to customize the deployment:
# cp .env.example .env
# ==============================================================================

# Configure the host interface and port that the Caddy ingress server binds to.
# Examples:
# - "80"                   -> Binds to port 80 on all network interfaces (publicly accessible, default)
# - "127.0.0.1:80"         -> Binds to port 80 on localhost only (local access only)
# - "127.0.0.1:8080"       -> Binds to port 8080 on localhost only
# - "192.168.1.100:8080"   -> Binds to port 8080 on a specific local network interface
CADDY_BIND_ADDRESS=127.0.0.1:8080
